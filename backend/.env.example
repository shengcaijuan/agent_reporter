# 应用配置
APP_NAME=销售报告生成系统
APP_VERSION=1.0.0
DEBUG=false

# API 配置
API_PREFIX=/api

# CORS 配置（多个用逗号分隔）
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# JWT 配置
SECRET_KEY=your-secret-key-please-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 数据库配置
DATABASE_URL=sqlite:///./data/app.db

# 云端 LLM 配置（通义千问）
CLOUD_API_KEY=your-dashscope-api-key
CLOUD_MODEL_NAME=qwen3.5-plus
CLOUD_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 本地 LLM 配置（可选）
LOCAL_API_KEY=
LOCAL_MODEL_NAME=
LOCAL_BASE_URL=

# 数据源配置
DATA_API_BASE_URL=